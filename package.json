{
  "name": "airgrid-vue",
  "version": "0.1.0",
  "description": "Airtable-style data grid for Vue 3 — TanStack Vue Table + Virtual. Port of airgrid.",
  "license": "MIT",
  "author": "pshqkr",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/airgrid-vue.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/vue-table": "^8",
    "@tanstack/vue-virtual": "^3",
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@tanstack/vue-table": "^8.20.5",
    "@tanstack/vue-virtual": "^3.10.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
